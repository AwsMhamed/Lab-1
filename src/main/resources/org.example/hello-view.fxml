<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="376.0" prefWidth="502.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <TextField fx:id="emailField" prefHeight="25.0" prefWidth="313.0" promptText="Enter your email" />
    <TextField fx:id ="passwordField" prefHeight="25.0" prefWidth="222.0" promptText="Enter your password" />
    <Button mnemonicParsing="false" text="login" textFill="#ff00007a" onAction="#onLoginClick">
        <font>
            <Font name="Arial" size="12.0" />
        </font>
    </Button>
    <Label fx:id="errorLabel"
           text=""
           textFill="RED" />

</VBox>
